# Frontend Environment Configuration
# Copy to .env.local and adjust as needed for local development

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Azure Speech-to-Text (Frontend Configuration)
# These credentials are used by the frontend Azure Speech SDK
# For security, consider using a backend proxy endpoint instead
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=eastasia

# Feature Flags
VITE_ENABLE_AZURE_SPEECH=true
VITE_ENABLE_LOCAL_SPEECH_FALLBACK=true
VITE_SPEECH_DEFAULT_LANGUAGE=zh-TW
VITE_AUTO_SAVE_INTERVAL_MS=4000

# LiveKit Configuration (optional, for meeting features)
VITE_LIVEKIT_URL=
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8000/api/v1/interviews/livekit-token
